NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Public base URL of the live site. Needed client-side because the Company
# Analyzer's downloadable report is a standalone HTML file that may be opened
# from anywhere, so it can't use a relative link back to the dashboard.
NEXT_PUBLIC_SITE_URL=https://arisoft.nl

# /dashboard internal tool
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_TOKEN=

# /dashboard email sending (Google Workspace SMTP App Passwords)
DASHBOARD_SMTP_INFO_APP_PASSWORD=
DASHBOARD_SMTP_ARJMANDI_APP_PASSWORD=

# /dashboard AI email content generation (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# /dashboard AI company analyzer, research stage (OpenAI, web search).
# For deeper, more reasoned research consider a reasoning-capable model
# (e.g. an o-series or gpt-5 model) if available on your account.
OPENAI_ANALYZER_MODEL=gpt-4o

# Both only apply when OPENAI_ANALYZER_MODEL is a reasoning-capable model
# (e.g. gpt-5.x, o-series) — non-reasoning models like gpt-4o reject these
# params, so each is only sent when explicitly set here; leave blank
# otherwise. Some reasoning model families default context to all_turns,
# which re-sends every earlier turn's full reasoning as input on each
# subsequent turn — for a multi-turn web_search research call that compounds
# fast and is a likely driver of unusually large research responses/token
# usage. Set to current_turn to stop that compounding. Allowed values: auto,
# current_turn, all_turns.
OPENAI_RESEARCH_REASONING_CONTEXT=

# Lowers how much reasoning the model does per turn in the first place
# (fewer hidden reasoning tokens = smaller/faster/cheaper responses). Allowed
# values: none, minimal, low, medium, high, xhigh, max. Not every value is
# supported by every reasoning model — check the model's docs if a value is
# rejected.
OPENAI_RESEARCH_REASONING_EFFORT=

# /dashboard AI company analyzer, analysis stage (OpenAI, no search — reasons
# over the research stage's notes only). Falls back to OPENAI_ANALYZER_MODEL,
# then gpt-4o, if unset. Safe to point at a cheaper/faster model since it
# doesn't need search capability.
OPENAI_ANALYST_MODEL=gpt-4o

# /dashboard AI company analyzer -> outreach email generation (OpenAI)
OPENAI_COMPANY_EMAIL_MODEL=gpt-4o

# /dashboard AI company analyzer — retry/pacing tuning. One company's
# pipeline fires 3 OpenAI calls (research -> analyze -> generate email); with
# no gap between them their combined usage can burst past an org's
# tokens-per-minute limit even though separate companies are paced fine.
# OPENAI_MAX_RETRIES raises the OpenAI SDK's own retry budget (default 2) so
# it has more room to ride out a transient 429 (the SDK already honors the
# response's Retry-After header, capped at 60s per retry). Kept conservative
# by default so total retry time across the chain stays under the 10-minute
# staleness windows in companyQueue/state.ts and companyQueue/queue.ts — raise
# it only alongside those. OPENAI_CALL_SPACING_MS adds a deliberate pause
# between the chained calls so the burst is less likely to happen at all. Tune
# both using the per-call token-usage logs each call emits.
OPENAI_MAX_RETRIES=3
OPENAI_CALL_SPACING_MS=6000

# /dashboard Companies (Postgres via Neon or Supabase free tier — connection
# string must include sslmode=require, which both providers include by default)
DASHBOARD_DATABASE_URL=

# /dashboard Company queue — how many queued companies a single
# /api/cron/tick call claims and works through before responding. Keep this
# low (1 is the default) since a scheduler-triggered tick blocks on the full
# batch (each company normally takes under ~1 minute, more if OpenAI
# rate-limit retries kick in — see OPENAI_MAX_RETRIES above) before it can
# respond — raising it doesn't increase throughput (the schedule just ticks
# again), it only makes each individual call take longer.
QUEUE_BATCH_SIZE=1

# /dashboard Email queue auto-publish pacing (src/lib/email/publishTick.ts) —
# keeps bulk sending from tripping Gmail's own bulk-sender abuse detection.
# MIN_INTERVAL is the base gap between sends (randomized +0-50% in code, so
# sends don't land on a robotic fixed cadence); MAX_PER_HOUR/DAY are hard
# caps per sender; RETRY_COOLDOWN is how long a failed auto-send attempt
# waits before being retried automatically (the manual "Send" button can
# always retry sooner).
EMAIL_SEND_MIN_INTERVAL_SECONDS=45
EMAIL_SEND_MAX_PER_HOUR=20
EMAIL_SEND_MAX_PER_DAY=150
EMAIL_SEND_RETRY_COOLDOWN_MINUTES=30

# /dashboard Bearer secret for the scheduled /api/cron/tick route (drives the
# company queue and email auto-publish in the background, independent of any
# browser tab). Whatever external scheduler calls this route must send
# `Authorization: Bearer <this value>`.
CRON_SECRET=