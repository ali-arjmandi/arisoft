NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Public base URL of the live site. Needed client-side because the Company
# Analyzer's downloadable report is a standalone HTML file that may be opened
# from anywhere, so it can't use a relative link back to the panel.
NEXT_PUBLIC_SITE_URL=https://arisoft.nl

# /panel internal tool
PANEL_USERNAME=
PANEL_PASSWORD=
PANEL_SESSION_TOKEN=

# /panel email sending (Google Workspace SMTP App Passwords)
PANEL_SMTP_INFO_APP_PASSWORD=
PANEL_SMTP_ARJMANDI_APP_PASSWORD=

# /panel AI email content generation (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# /panel AI company analyzer (OpenAI, web search)
# For deeper, more reasoned research consider a reasoning-capable model
# (e.g. an o-series or gpt-5 model) if available on your account.
OPENAI_ANALYZER_MODEL=gpt-4o

# /panel AI company analyzer -> outreach email generation (OpenAI)
OPENAI_COMPANY_EMAIL_MODEL=gpt-4o